<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules (referenced from AndroidManifest.xml).
  Every app-private domain is excluded from BOTH cloud backup and
  device-to-device transfer: the encrypted database (app_flutter/, inside
  "root"), secure-storage SharedPreferences, files, and databases.
  A mode with no section here would be fully enabled, so both are listed.
  The app's controlled encrypted recovery package is the intended backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
